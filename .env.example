# AmBright Global Traders — Environment Configuration
# Copy this file to .env to enable live email delivery for incoming buyer RFQs

# Web Server Port
PORT=3000
HOST=0.0.0.0

# Trade Desk Inbox for alerts (backend internal routing)
NOTIFICATION_EMAIL=trade@ambrightglobal.com
ADDITIONAL_ALERT_EMAILS=skpokkalla@gmail.com

# ==============================================================================
# Live SMTP Email Settings (e.g. Gmail, Zoho Mail, Google Workspace, SendGrid)
# ==============================================================================
# For Gmail / Google Workspace:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an "App Password" (16 letters) under Security -> App Passwords
# 3. Enter details below:
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password

# For Zoho Mail:
# SMTP_HOST=smtppro.zoho.com
# SMTP_PORT=465
# SMTP_USER=trade@ambrightglobal.com
# SMTP_PASS=your-zoho-password

# Optional: Webhook URL (Slack, Zapier, Make) for instant mobile notifications
# WEBHOOK_EMAIL_URL=https://hooks.zapier.com/hooks/catch/...

